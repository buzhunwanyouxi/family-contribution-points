// Data model -- PROJECT_GUIDE section 7.
// Dev uses sqlite for zero-setup; production switches to postgresql (same schema).
// SHARED FILE: announce changes in your ops log and update docs/CONTRACTS.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  nickname     String
  avatarUrl    String?
  pwdHash      String
  wechatOpenid String?
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Family {
  id             String   @id @default(cuid())
  name           String
  ownerId        String
  inviteCode     String   @unique
  inviteExpireAt DateTime?
  timezone       String   @default("Asia/Shanghai")
  createdAt      DateTime @default(now())

  memberships Membership[]
  templates   TaskTemplate[]
  instances   TaskInstance[]
  wishes      Wish[]
}

model Membership {
  id           String   @id @default(cuid())
  userId       String
  familyId     String
  role         String   // owner | admin | member | child
  points       Float    @default(0) // current available points
  frozenPoints Float    @default(0) // held for published bounties
  earnedPoints Float    @default(0) // cumulative earned, never decreases (F4)
  spentPoints  Float    @default(0) // redeemed + contributed to wishes (F5)
  joinedAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  family Family @relation(fields: [familyId], references: [id])

  @@unique([userId, familyId])
}

model TaskTemplate {
  id              String   @id @default(cuid())
  familyId        String
  title           String
  description     String?
  timeOfDay       String   // "14:00"
  repeatRule      String   // daily | weekly:1,3,5 | monthly:1
  maxPoints       Float
  assignMode      String   @default("claim") // claim | rotate
  claimerScope    String   @default("all") // all | children | specific
  mustBeClaimed   Boolean  @default(true)
  remindBeforeMin Int      @default(30)
  status          String   @default("active") // active | paused | archived
  createdBy       String
  createdAt       DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id])
}

model TaskInstance {
  id           String    @id @default(cuid())
  templateId   String?
  familyId     String
  date         DateTime
  title        String
  maxPoints    Float
  deadlineAt   DateTime
  status       String    @default("寰呮帴鍙?)
  claimerId    String?
  claimedAt    DateTime?
  autoAssigned Boolean   @default(false)
  finalPercent Int?
  finalPoints  Float?
  settledAt    DateTime?
  settledBy    String? // owner | others_avg | fallback_60
  createdAt    DateTime  @default(now())

  family Family       @relation(fields: [familyId], references: [id])
  proof  ProofMedia[]
}

model ProofMedia {
  id          String    @id @default(cuid())
  refType     String // instance | task
  refId       String
  uploaderId  String
  type        String // image | video
  url         String
  thumbUrl    String?
  durationSec Int?
  sizeBytes   Int?
  expireAt    DateTime // = uploadedAt + PROOF_TTL_HOURS (default 72h)
  status      String    @default("鏈夋晥") // 鏈夋晥 | 宸茶繃鏈?  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  instance TaskInstance? @relation(fields: [refId], references: [id])

  @@index([expireAt, status])
}

model Score {
  id        String   @id @default(cuid())
  refType   String
  refId     String
  scorerId  String
  percent   Int
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([refType, refId, scorerId])
}

model PointsTxn {
  id           String   @id @default(cuid())
  userId       String
  familyId     String
  delta        Float
  reason       String // 浠诲姟瀹屾垚 | 鎮祻鏀嚭 | 鎮祻閫€鍥?| 鎰挎湜鎶曞叆 | 鍏戞崲 | 鍐叉 | 绠＄悊鍛樿皟鏁?  earned       Boolean  @default(false)
  refType      String?
  refId        String?
  balanceAfter Float
  operatorId   String?
  createdAt    DateTime @default(now())
}

model Wish {
  id                 String    @id @default(cuid())
  familyId           String
  title              String
  imageUrl           String?
  description        String?
  targetPoints       Float
  contributedPoints  Float     @default(0)
  status             String    @default("寰呭畾浠?) // 寰呭畾浠?| 鏀掑垎涓?| 宸茶揪鎴?| 宸插厬鐜?| 宸蹭笅鏋?  createdBy          String
  pricedBy           String?
  pricedAt           DateTime?
  redeemedAt         DateTime?
  redeemedBy         String?
  createdAt          DateTime  @default(now())

  family        Family             @relation(fields: [familyId], references: [id])
  contributions WishContribution[]
}

model WishContribution {
  id        String   @id @default(cuid())
  wishId    String
  userId    String
  points    Float
  createdAt DateTime @default(now())

  wish Wish @relation(fields: [wishId], references: [id])
}

model Discipline {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  type      String // 鏈饱绾?| 寮冨崟 | 琚┏鍥?| 鐮存崯
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime @default(now())
}