# Normalize line endings for a mixed Windows / macOS / Linux team.
# Without this, every Windows contributor produces CRLF churn in diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.prisma text eol=lf
