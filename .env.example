# ---- server ----
PORT=3000
NODE_ENV=development

# ---- database ----
# dev default: sqlite file; production: postgres connection string
DATABASE_URL="file:./dev.db"

# ---- auth ----
JWT_SECRET=change-me-in-production

# ---- media / proof evidence ----
# Task proof photos & videos are deleted automatically after this many hours (see PROJECT_GUIDE 4.10)
PROOF_TTL_HOURS=72
# remind when this many hours are left before deletion (comma separated)
PROOF_REMIND_BEFORE_HOURS=24,6
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# object storage (production)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- scoring rules (PROJECT_GUIDE 4.5) ----
SCORE_WINDOW_HOURS=24
SCORE_FLOOR_PERCENT=30
SCORE_STEP_PERCENT=5
SCORE_FALLBACK_PERCENT=60

# ---- notifications ----
# wechat | sms | console
NOTIFY_DRIVER=console